# Test-only settings for e2e tests (bun run test:e2e).
# Safe to commit: no real secrets. NEVER use these values outside tests.
# Overrides .env; keys not listed here fall back to .env.example defaults.

NODE_ENV=test
PORT=3001
LOG_LEVEL=warn

# Separate database so tests never touch dev data
DATABASE_URL=postgres://malnest:malnest@localhost:5432/malnest_test
# Redis DB 1 keeps test queues apart from dev queues (DB 0)
REDIS_URL=redis://localhost:6379/1

S3_BUCKET=malnest-quarantine-test

# Never call VirusTotal from tests (BR-10: empty key means skipped)
VT_API_KEY=

# Fixed, fake key (32 bytes of "t"). TEST ONLY.
WEBHOOK_ENCRYPTION_KEY=dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHQ=

# Short limits so tests run fast
SCAN_TIMEOUT_MINUTES=1
MAX_UPLOAD_BYTES=1048576
