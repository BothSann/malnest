# malnest environment variables
#
# Copy to .env for local development:   cp .env.example .env
# Never commit .env. Every key here is validated at startup (NFR-23);
# the app refuses to start if a required key is missing or invalid.
# Defaults below match the local docker-compose services (T-03).
# Rule IDs (BR-xx) point to docs/BUSINESS_RULES.md.

# ─── App ─────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# HTTP port for the API process
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ─── Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgres://malnest:malnest@localhost:5432/malnest

# ─── Redis (BullMQ + rate limits) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3 API: MinIO locally, Cloudflare R2 in prod) ───
# R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=malnest-quarantine
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO, false for R2
S3_FORCE_PATH_STYLE=true

# ─── ClamAV (clamd over TCP) ─────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# ─── VirusTotal (hash lookup only, BR-09) ────────────────────────────
# Leave empty to skip VirusTotal (BR-10). Free key: https://www.virustotal.com
VT_API_KEY=
VT_TIMEOUT_MS=15000
# Free tier allows 500 lookups per day (BR-10)
VT_DAILY_LIMIT=500
# Detections at or above this count mean "malicious" (BR-13, BR-14)
VT_MALICIOUS_THRESHOLD=3

# ─── Webhooks ────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts webhook signing secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000
# Max webhooks per owner (BR-31)
MAX_WEBHOOKS_PER_OWNER=3

# ─── Uploads and archives ────────────────────────────────────────────
# 50 MB (BR-18). ClamAV StreamMaxLength must be at least this.
MAX_UPLOAD_BYTES=52428800
# Zip bomb limits (BR-20)
ARCHIVE_MAX_DEPTH=3
ARCHIVE_MAX_ENTRIES=1000
# 500 MB
ARCHIVE_MAX_UNPACKED_BYTES=524288000
ARCHIVE_MAX_RATIO=100

# ─── Scans ───────────────────────────────────────────────────────────
# Fail scans stuck in queued/scanning longer than this (BR-03)
SCAN_TIMEOUT_MINUTES=10
# Reuse an owner's own recent result for the same file (BR-21)
RESULT_REUSE_HOURS=24
# Jobs per worker process for scan-local and scan-finalize (NFR-13)
WORKER_CONCURRENCY=2
STORAGE_TIMEOUT_MS=30000

# ─── Access and rate limits ──────────────────────────────────────────
# Active API keys per owner (BR-27)
MAX_KEYS_PER_OWNER=5
# Per API key (BR-29)
RATE_UPLOADS_PER_MINUTE=10
RATE_UPLOADS_PER_DAY=200
RATE_REQUESTS_PER_MINUTE=120

# ─── Retention ───────────────────────────────────────────────────────
# Delete stored files after (BR-35)
FILE_RETENTION_DAYS=7
# Delete scan records after (BR-36)
RECORD_RETENTION_DAYS=90
