{
  "name": "malnest",
  "version": "0.0.1",
  "description": "Self-hosted NestJS API that scans uploaded files for malware",
  "author": "BothSann",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --watch --debug",
    "build": "nest build",
    "start": "node dist/main",
    "clean": "node -e \"for (const d of ['dist', 'coverage', 'tsconfig.build.tsbuildinfo']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,apps,libs,test}/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,apps,libs,test}/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "services:reset": "docker compose down -v"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
